{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  // `supabase/functions` tourne sous Deno, pas sous Expo : imports par URL,
  // `Deno.serve`, sa propre bibliothèque standard. Le vérificateur de
  // l'application n'a rien à y comprendre — c'est Supabase qui la compile.
  "exclude": ["supabase/functions", "node_modules", "dist"]
}
